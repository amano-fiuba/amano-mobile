# Build Android (amano-mobile specs/001-android-app, D3/D9): la app habla con el backend
# de producción por HTTPS. Para el backend local, crear .env.android.local
# (ignorado) con VITE_API_BASE_URL=http://localhost:8081 y usar adb reverse.
VITE_API_BASE_URL=https://amano-fiuba.duckdns.org
# Diseño móvil (amano-mobile specs/002-diseno-movil-y-notificaciones): pestañas, barra inferior y pasos.
VITE_MOBILE_LAYOUT=true
